# OpenAI path (RAGAS evaluator/embeddings; optional fallback provider for generation)
OPENAI_API_KEY=

# OpenCode Go (https://opencode.ai/zen/go/v1). When set, answer generation and
# M5 enrichment use this provider instead of OpenAI.
OPENCODE_GO_API_KEY=
# Optional overrides (defaults shown)
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Stable per-conversation id for OpenCode Go routing; random when unset.
# OPENCODE_GO_SESSION=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
